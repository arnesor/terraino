// The viewer on Cloudflare: Vite's build and the world files as static assets, and a Worker
// for the results lists, kept in D1 (docs/adr/0003-results-stored-in-d1-by-a-worker.md).
// `npm run deploy` builds and uploads it; `npm run dev` runs the Worker locally.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terraino",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  // No public address for each uploaded version; only the deployed one is served.
  "preview_urls": false,
  // Static assets are served first, except for /results/, which is the Worker's.
  "assets": { "binding": "ASSETS", "run_worker_first": ["/results/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terraino-results",
      "database_id": "067ad405-079c-488a-8e0c-72a801170034",
      "migrations_dir": "worker/migrations",
    },
  ],
  // The key that may delete any result: `npx wrangler secret put ADMIN_KEY`.
  "secrets": { "required": ["ADMIN_KEY"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "upload_source_maps": true,
}
